import java.util.ArrayList;
import java.util.List;

class Solution {
    public List<String> generateParenthesis(int n) {
        List<String> result = new ArrayList<>();
        backtrack(result, "", 0, 0, n);
        return result;
    }

    private void backtrack(List<String> result, String currentString, int openCount, int closeCount, int n) {
        // Base case: if the current string has reached length 2 * n, it's a valid combination
        if (currentString.length() == 2 * n) {
            result.add(currentString);
            return;
        }

        // Add an open parenthesis if we haven't used all n open parentheses
        if (openCount < n) {
            backtrack(result, currentString + "(", openCount + 1, closeCount, n);
        }

        // Add a close parenthesis if there are unmatched open parentheses
        if (closeCount < openCount) {
            backtrack(result, currentString + ")", openCount, closeCount + 1, n);
        }
    }
}
